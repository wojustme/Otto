{
  "name": "otto",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @otto/desktop tauri dev",
    "dev:ui": "pnpm --filter @otto/desktop dev",
    "dev:runtime": "pnpm --filter @otto/runtime dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check:rust": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all"
  }
}
